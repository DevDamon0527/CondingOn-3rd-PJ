# =============================================
# NaiClover Server - 환경변수 예시 파일
# 실제 사용 시 .env 로 복사해서 값을 채워주세요
# =============================================

# MySQL 접속 정보
MYSQLUSERNAME=           # MySQL 사용자명 (예: root)
MYSQLUSERPASSWORD=       # MySQL 비밀번호
DATABASENAME=            # 사용할 데이터베이스명 (예: naiclover)
MYSQLPORT=3306           # MySQL 포트 (기본값: 3306)

# 서버 주소
SERVERIPNO=localhost     # DB 서버 IP (로컬: localhost)
SERVERPORT=4000          # Express 서버 포트
SERVERURL=http://localhost:4000

# CORS 허용 주소 (프론트엔드 주소)
CLIENTURL=http://localhost:3000

# 세션 암호화 키 (운영 환경에서는 충분히 길고 랜덤한 문자열로 교체)
SECRETKEY=
